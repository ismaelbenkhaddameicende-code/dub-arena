# ---- Servidor -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Incluye el WebView del APK (https://localhost) y el servidor HTTPS de la red local.
# Para probar en el movil por la red local puedes poner CORS_ORIGINS=* temporalmente.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
MEDIA_TOKEN_TTL=3600

# ---- Almacenamiento (relativo a la raiz del proyecto) ---------------------
STORAGE_DIR=storage

# ---- FFmpeg ---------------------------------------------------------------
# En Windows, si no esta en el PATH, pon la ruta completa:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Servicio de IA (Python / FastAPI) ------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=1800000

# ---- Hugging Face (solo si usas diarizacion pyannote) ---------------------
# Crea el token en https://huggingface.co/settings/tokens y acepta las
# condiciones de pyannote/speaker-diarization-3.1 antes de usarlo.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ------------------------- Despliegue (produccion) -------------------------
# Render o Docker: el backend sirve tambien la web compilada.
# SERVE_STATIC=1
# NODE_ENV=production
# JWT_SECRET=<cadena larga y aleatoria; en Render se genera sola>

# Cloudflare Pages: URL publica del backend, se incrusta al compilar.
# VITE_API_URL=https://dub-arena.onrender.com

# El backend solo acepta estos origenes. Anade el de tu Pages y el del APK.
# CORS_ORIGINS=https://dub-arena.pages.dev,https://localhost,capacitor://localhost
